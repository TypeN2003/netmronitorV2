# ---------- Database ----------
# SQLite file, relative to the server/prisma folder
DATABASE_URL="file:./netmonitor.db"

# ---------- HTTP ----------
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"

# ---------- Auth ----------
# CHANGE THIS. Any long random string. Used to sign JWTs (HS256).
JWT_SECRET="change-me-to-a-long-random-string"
# Token lifetime. Short-lived sessions log out sooner.
JWT_EXPIRES_IN="12h"

# ---------- Seed account (created on first `npm run db:seed`) ----------
SEED_ADMIN_EMAIL="admin@netmonitor.internal"
SEED_ADMIN_PASSWORD="admin123"
SEED_ADMIN_NAME="NetMonitor Administrator"

# Seed one real device so the first poll has something to talk to.
# Leave SEED_DEVICE_IP empty to start with an empty inventory.
SEED_DEVICE_IP=""
SEED_DEVICE_NAME="Core-SW-01"
SEED_DEVICE_TYPE="Core Switch"
SEED_DEVICE_COMMUNITY="public"

# ---------- SNMP collector ----------
# Seconds to wait for an SNMP reply before the device counts as unreachable
SNMP_TIMEOUT_MS=4000
SNMP_RETRIES=1
# How many devices to poll at the same time
SNMP_CONCURRENCY=5
# Walk the bridge forwarding table to fill in each port's connected MAC.
# Costs an extra walk per switch; turn off on large switches.
SNMP_COLLECT_FDB=true
# Set to false to keep the API up without touching the network (no polling at all)
POLLER_ENABLED=true

# ---------- Thresholds (must match the frontend constants) ----------
CPU_ALERT_THRESHOLD=85
RAM_ALERT_THRESHOLD=90

# ---------- Retention ----------
# Telemetry samples feed the Dashboard/Statistics charts
TELEMETRY_RETENTION_HOURS=168
SYSLOG_MAX_ROWS=5000
